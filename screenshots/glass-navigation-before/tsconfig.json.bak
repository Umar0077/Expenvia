{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-email-e2e/types/**/*.ts",
    ".next-email-e2e/dev/types/**/*.ts",
    ".next-email-build/types/**/*.ts",
    ".next-email-build/dev/types/**/*.ts",
    ".next-atelier-build/types/**/*.ts",
    ".next-atelier-build/dev/types/**/*.ts",
    ".next-landing-build/types/**/*.ts",
    ".next-landing-build/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
