.hero-financial-preview{position:relative;width:100%;max-width:620px;margin-inline:auto;padding-top:48px;padding-bottom:12px;}
.preview-dashboard{position:relative;border:1px solid color-mix(in srgb,var(--brand) 35%,var(--border));border-radius:24px 9px 24px 9px;padding:18px 18px 50px;background:linear-gradient(150deg,var(--surface),color-mix(in srgb,var(--surface) 94%,var(--brand)));box-shadow:inset 0 1px 0 #ffffff66,0 28px 55px -30px #173e3566;}
.dark .preview-dashboard{box-shadow:inset 0 1px 0 #bddbc92b,0 28px 55px -30px #000a;}
.preview-dashboard::before{content:"";position:absolute;inset:5px;border:1px solid color-mix(in srgb,var(--brand) 10%,transparent);border-radius:19px 5px 19px 5px;pointer-events:none;}
.preview-window{display:flex;align-items:center;gap:12px;font-size:12px;color:var(--text-muted);padding:2px 0 16px;border-bottom:1px solid var(--border);}
.preview-window>svg{margin-inline-start:auto;color:var(--brand);}
.preview-window-dots{display:flex;gap:4px;}.preview-window-dots i{width:5px;height:5px;border-radius:50%;background:var(--border-strong);}
.preview-metrics{display:grid;grid-template-columns:1.2fr .7fr 1.1fr;gap:9px;margin-block:18px;}
.preview-metric{height:100%;padding:12px 10px;border:1px solid var(--border);border-radius:12px 4px 12px 4px;background:var(--surface);}
.preview-metric p{font-size:11px;line-height:1.6;color:var(--text-muted);margin-bottom:7px;}
.preview-metric strong{display:block;font-size:clamp(.85rem,1.2vw,1.1rem);font-weight:600;white-space:nowrap;}
.preview-metric-1 strong{color:var(--warning);}.preview-metric-2 strong{color:var(--copper);}
.preview-chart-heading{display:flex;justify-content:space-between;align-items:center;font-size:12px;color:var(--text-muted);margin-block:20px 14px;}
.preview-chart-heading svg{color:var(--brand);}
.preview-chart{position:relative;height:170px;display:flex;align-items:end;gap:14px;padding:10px 8px 0;border-bottom:1px solid var(--border);isolation:isolate;direction:ltr;}
.preview-chart-grid{position:absolute;inset:0;background:repeating-linear-gradient(0deg,transparent 0,transparent calc(25% - 1px),var(--border) 25%);opacity:.7;z-index:-1;}
.preview-bar{flex:1;transform-origin:bottom;border-radius:6px 6px 0 0;background:linear-gradient(0deg,color-mix(in srgb,var(--brand) 20%,var(--surface)),var(--brand));}
.preview-chart svg{position:absolute;inset:15% 0 10%;width:100%;height:75%;overflow:visible;}
.preview-chart-footer{display:flex;gap:10px;align-items:center;justify-content:space-between;margin-top:12px;font-size:10px;color:var(--text-muted);}
.preview-period{font-family:var(--font-sans);font-size:10px;white-space:nowrap;}
.preview-invoice-position{position:absolute;top:0;inset-inline-start:-12px;max-width:90%;}
.preview-invoice{display:flex;align-items:center;gap:12px;padding:12px 16px;background:var(--surface-elevated);border:1px solid color-mix(in srgb,var(--brand) 40%,var(--border));border-radius:17px 6px 17px 6px;box-shadow:0 12px 24px -18px #153c3599;animation:preview-invoice-float 6.5s ease-in-out infinite alternate;}
.preview-invoice-icon{display:grid;place-items:center;flex-shrink:0;width:36px;height:40px;color:var(--brand);background:var(--brand-soft);border-radius:10px 3px 10px 3px;}
.preview-reference{font-size:10px;line-height:1.5;color:var(--text-muted);}
.preview-approved{display:flex;align-items:center;gap:6px;font-size:13px;font-weight:600;color:var(--success);margin-top:4px;}
.preview-branch-position{position:relative;width:57%;margin-inline-start:auto;margin-inline-end:-14px;margin-top:-30px;}
.preview-branch{position:relative;padding:15px 18px;background:var(--surface-elevated);border:1px solid color-mix(in srgb,var(--copper) 35%,var(--border));border-radius:18px 6px 18px 6px;box-shadow:0 14px 26px -19px #173e3588;animation:preview-branch-float 8s ease-in-out infinite alternate;}
.preview-branch>p{font-size:12px;font-weight:500;margin-bottom:12px;}
.preview-branch-list{display:grid;gap:9px;}.preview-branch-list>div{display:flex;gap:12px;align-items:center;}
.preview-branch-list .ltr-data{font-size:10px;color:var(--text-muted);width:26px;}
.preview-branch-track{height:5px;background:var(--surface-2);border-radius:4px;flex:1;overflow:hidden;}.preview-branch-track i{height:100%;display:block;border-radius:inherit;}
@keyframes preview-invoice-float{from{transform:translateY(2px) rotate(-.4deg)}to{transform:translateY(-5px) rotate(.4deg)}}
@keyframes preview-branch-float{from{transform:translateY(-3px)}to{transform:translateY(3px)}}
.hero-financial-preview[data-paused="true"] .preview-float,html[data-tab-hidden] .preview-float{animation-play-state:paused;}
.hero-financial-preview[data-static="true"] .preview-float{animation:none;}
.hero-financial-preview[data-static="true"]{transform:none!important;}
@media(min-width:1600px){.preview-chart{height:210px;}}
@media(max-width:1023px){.hero-financial-preview{max-width:580px;}.preview-metric strong{font-size:17px;}.preview-invoice-position{inset-inline-start:0;}.preview-branch-position{margin-inline-end:0;}}
@media(max-width:639px){.hero-financial-preview{padding-top:72px;}.preview-dashboard{padding:16px 14px 42px;}.preview-chart{height:126px;gap:9px;}.preview-metrics{gap:7px;grid-template-columns:1fr 1fr;}.preview-metrics>div:last-child{grid-column:span 2;}.preview-metrics>div:last-child .preview-metric{display:flex;align-items:center;justify-content:space-between;gap:10px;}.preview-metrics>div:last-child p{margin:0;}.preview-metric{padding:9px;}.preview-metric strong{font-size:15px;}.preview-branch-position{width:85%;}.preview-branch-list{grid-template-columns:1fr 1fr;column-gap:16px;}.preview-branch-list>div{gap:6px;}.preview-branch{padding:13px 14px;}.preview-window{font-size:11px;}.preview-chart-footer{line-height:1.6;}}
@media(prefers-reduced-motion:reduce){html:not([data-motion="full"]) .preview-float{animation:none!important;}}
html[data-motion="reduced"] .preview-float{animation:none!important;}
