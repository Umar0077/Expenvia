                  </Button>
                </Magnetic>
                <Button asChild size="lg" variant="secondary">
                  <a href="#workflow">{t("ctaSecondary")}</a>
                </Button>
              </Reveal>
            </div>
            <HeroVisual />
          </div>
        </section>

        {/* WORKFLOW */}
        <WorkflowJourney />

        {/* CAPABILITIES */}
        <section id="capabilities" className="landing-capabilities scroll-mt-20">
