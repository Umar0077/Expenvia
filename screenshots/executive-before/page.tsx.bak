              </Reveal>
              <Reveal delay={0.08}>
                <h1 className="hero-headline font-display mt-6 text-balance text-4xl font-semibold tracking-[-0.03em] text-text sm:text-5xl lg:text-[3.6rem] lg:leading-[1.05]">
                  {t("heroTitle")}
