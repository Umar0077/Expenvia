    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "postinstall": "prisma generate",
    "dev:demo": "node scripts/dev-demo.mjs",
    "test:unit": "vitest run src",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:test:migrate": "node scripts/migrate-test.mjs",
    "db:reset-demo": "node scripts/reset-demo.mjs",
    "email:worker": "node --conditions=react-server --import tsx scripts/email-worker.ts",
    "email:preview": "node --conditions=react-server --import tsx scripts/email-preview.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
