    "@prisma/client": "^7.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.10",
    "lucide-react": "^1.72.0",
    "motion": "^14.13.0",
    "next": "^16.4.6",
    "next-intl": "^4.15.1",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "playwright": "^1.65.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
