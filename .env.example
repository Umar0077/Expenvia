# Copy to .env and adjust. Never commit .env.

# PostgreSQL (docker compose maps the container to host port 5433)
DATABASE_URL="postgresql://expenvia:expenvia_dev_only@localhost:5433/expenvia?schema=public"

# Public base URL (used in verification / reset links)
APP_URL="http://localhost:3000"

# Session lifetime in hours
SESSION_TTL_HOURS=12

# Private file storage directory (outside /public)
STORAGE_DIR="./storage"

# Email outbox and independent worker. Development writes PRIVATE previews, never sends.
EMAIL_PROVIDER="development"
EMAIL_FROM_NAME="Expenvia"
EMAIL_FROM_ADDRESS=""
APP_PUBLIC_URL="http://localhost:3000"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# Required in production: 32 random bytes encoded as 64 hexadecimal characters.
# Web and workers must share this key. Local development creates storage/email/.key.
EMAIL_ENCRYPTION_KEY=""

# One-time Super Admin bootstrap (scripts/bootstrap-admin.ts). Remove after use.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_PASSWORD=""

# Demo data seeding is refused unless this is "true" AND NODE_ENV != production
ALLOW_DEMO_SEED="false"

# Isolated databases (never point these at production data)
DEMO_DATABASE_URL="postgresql://expenvia:expenvia_dev_only@localhost:5433/expenvia_demo?schema=public"
TEST_DATABASE_URL="postgresql://expenvia:expenvia_dev_only@localhost:5433/expenvia_test?schema=public"

# DEVELOPMENT ONLY: enables /dev-access (create pre-approved accounts of any role). Never enable in production.
ALLOW_DEV_ACCOUNTS="false"
